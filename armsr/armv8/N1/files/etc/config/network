config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

config interface 'lan'
	option proto 'static'
	option device 'eth0'
	option ipaddr '192.168.6.69/24'
	option gateway '192.168.6.1'
	option multipath 'off'
	option delegate '0'
	option ipv6 '0'
	list dns '223.5.5.5'
	list dns '119.29.29.29'

config globals 'globals'
	option packet_steering '2'
	option steering_flows '256'