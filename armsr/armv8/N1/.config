CONFIG_TARGET_armsr=y
CONFIG_TARGET_armsr_armv8=y
CONFIG_TARGET_armsr_armv8_DEVICE_generic=y
CONFIG_TARGET_ROOTFS_INITRAMFS=n
CONFIG_TARGET_ROOTFS_CPIOGZ=n
CONFIG_TARGET_ROOTFS_EXT4FS=n
CONFIG_TARGET_ROOTFS_SQUASHFS=n

# necessary —— luci-app-amlogic / flippy 打包与升级工具链的硬依赖，删了会导致写 eMMC / 在线升级失败
CONFIG_BTRFS_PROGS_ZSTD=y
CONFIG_PACKAGE_bsdtar=y
CONFIG_PACKAGE_btrfs-progs=y
CONFIG_PACKAGE_chattr=y
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_gawk=y
CONFIG_PACKAGE_getopt=y
CONFIG_PACKAGE_lsattr=y
CONFIG_PACKAGE_perlbase-getopt=y
CONFIG_PACKAGE_perlbase-unicode=y
CONFIG_PACKAGE_perl-http-date=y
CONFIG_PACKAGE_pigz=y
# tar 开 xz 支持会 select xz，而 xz 的 DEPENDS:=xz-utils 不带 +，被 package-metadata.pl
# 转成 tar 自己的 depends on；不显式打开这个空壳元包，defconfig 会把 tar 打成 n
CONFIG_PACKAGE_xz-utils=y
CONFIG_PACKAGE_tar=y
CONFIG_PACKAGE_xfs-fsck=y
CONFIG_PACKAGE_xfs-mkfs=y

# luci —— 显式钉住 Web UI 本体和它的两个服务端。只写 luci-app-* 时，整套界面
# 全靠 target 的 DEFAULT_PACKAGES 带进来，哪次 defconfig 一摘就成纯命令行固件
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_luci-app-amlogic=y
CONFIG_PACKAGE_luci-app-filetransfer=n
CONFIG_PACKAGE_luci-app-passwall2=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-passwall2-zh-cn=y
CONFIG_PACKAGE_luci-app-podman=n
CONFIG_PACKAGE_luci-app-samba4=n
CONFIG_PACKAGE_luci-app-dae=n

# passwall2 —— 透明代理走 nftables（ImmortalWrt 25.12 用 firewall4）
CONFIG_PACKAGE_luci-app-passwall2_Nftables_Transparent_Proxy=y
CONFIG_PACKAGE_luci-app-passwall2_Iptables_Transparent_Proxy=n

# passwall2 —— 核心全开。Basic_Core_All 同时选中 Xray 与 SingBox（Socks Config 里 http_port 的必要条件）
CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_All=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Haproxy=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Rust_Client=n
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_ShadowsocksR_Libev_Client=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Simple_Obfs=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_V2ray_Plugin=y

# passwall2 的 Makefile 不再提供 Hysteria / NaiveProxy / Shadow-TLS / Xray-Plugin / SmartDNS
# 的 INCLUDE_ 开关，改为直接选包，保持与原固件一致的「核心全开」；geoview / v2ray-geoip /
# v2ray-geosite 已是 luci-app-passwall2 的硬依赖，无需再单独打开
#
# 但 shadow-tls 与 shadowsocks-rust 的 Makefile 都写着 PKG_BUILD_DEPENDS:=rust/host，
# 会把宿主编译器 rust 拉进构建；ImmortalWrt 的 rust 固定 --set=llvm.download-ci-llvm=true，
# 要从 ci-artifacts.rust-lang.org 取预编译 LLVM，而该地址现在对所有版本（1.88–1.96）
# 都返回 404，rust 必然构建失败（20261112 那次就是这样断的）。所以这两个核心暂不编入：
# Shadowsocks 节点改用 Xray / sing-box 核心跑，功能不缺；Shadow-TLS 本来就是小众叠层。
CONFIG_PACKAGE_hysteria=y
CONFIG_PACKAGE_naiveproxy=y
CONFIG_PACKAGE_shadow-tls=n
CONFIG_PACKAGE_xray-plugin=y
CONFIG_PACKAGE_smartdns=y

# passwall2 —— 本机只做客户端/网关，不对外提供 SS/SSR 服务端
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Rust_Server=n
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_ShadowsocksR_Libev_Server=n

# ipv6 —— 去掉 v6 守护进程与 LuCI 的 v6 协议项；内核 IPv6 由 network.lan.ipv6='0' 在运行时禁用
# （CONFIG_IPV6 在 Config-build.in 里是 def_bool y，写 =n 会被 make defconfig 改回 y，所以不在这里动它）
CONFIG_PACKAGE_odhcp6c=n
CONFIG_PACKAGE_odhcpd-ipv6only=n
CONFIG_PACKAGE_luci-proto-ipv6=n

# kmod
CONFIG_PACKAGE_kmod-amazon-ena=n
CONFIG_PACKAGE_kmod-atlantic=n
CONFIG_PACKAGE_kmod-bcmgenet=n
CONFIG_PACKAGE_kmod-dwmac-imx=n
CONFIG_PACKAGE_kmod-dwmac-rockchip=n
CONFIG_PACKAGE_kmod-dwmac-sun8i=n
CONFIG_PACKAGE_kmod-e1000e=n
CONFIG_PACKAGE_kmod-fsl-dpaa1-net=n
CONFIG_PACKAGE_kmod-fsl-dpaa2-net=n
CONFIG_PACKAGE_kmod-fsl-enetc-net=n
CONFIG_PACKAGE_kmod-fsl-fec=n
CONFIG_PACKAGE_kmod-fsl-xgmac-mdio=n
CONFIG_PACKAGE_kmod-gpio-pca953x=n
CONFIG_PACKAGE_kmod-i2c-mux-pca954x=n
CONFIG_PACKAGE_kmod-macsec=n
CONFIG_PACKAGE_kmod-mdio-bcm-unimac=n
CONFIG_PACKAGE_kmod-mppe=n
CONFIG_PACKAGE_kmod-mvneta=n
CONFIG_PACKAGE_kmod-mvpp2=n
CONFIG_PACKAGE_kmod-net-selftests=n
CONFIG_PACKAGE_kmod-octeontx2-net=n
CONFIG_PACKAGE_kmod-phy-aquantia=n
CONFIG_PACKAGE_kmod-phy-broadcom=n
CONFIG_PACKAGE_kmod-phy-marvell=n
CONFIG_PACKAGE_kmod-phy-marvell-10g=n
CONFIG_PACKAGE_kmod-phy-realtek=n
CONFIG_PACKAGE_kmod-phy-smsc=n
CONFIG_PACKAGE_kmod-ppp=n
CONFIG_PACKAGE_kmod-ptp=n
CONFIG_PACKAGE_kmod-renesas-net-avb=n
CONFIG_PACKAGE_kmod-rtc-rx8025=n
CONFIG_PACKAGE_kmod-sfp=n
CONFIG_PACKAGE_kmod-stmmac-core=n
CONFIG_PACKAGE_kmod-thunderx-net=n
CONFIG_PACKAGE_kmod-vmxnet3=n
CONFIG_PACKAGE_kmod-wdt-sp805=n

# other packages
# lsblk 不在 busybox 25.12 的 applet 列表里，它由 luci-app-amlogic 的 +lsblk 选主仓库 util-linux 提供
CONFIG_PACKAGE_autocore=y
CONFIG_PACKAGE_automount=n
CONFIG_PACKAGE_fstrim=y
CONFIG_PACKAGE_partx-utils=n
CONFIG_PACKAGE_podman=n
CONFIG_PACKAGE_ppp=n
CONFIG_PACKAGE_shellsync=n
CONFIG_PACKAGE_zoneinfo-asia=y